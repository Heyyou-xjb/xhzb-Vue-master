# ======================================================================
# 后端（Spring Boot）环境变量示例
# ----------------------------------------------------------------------
# 说明：
#   1. Spring Boot 不会自动加载 .env 文件，请在启动前把下列变量注入进程环境
#      （Linux：export / docker -e / systemd Environment；Windows：setx 或
#        IDEA 运行配置中的 Environment variables）。
#   2. 本文件仅作为变量清单模板，请勿在此写入真实密码并提交。
# ======================================================================

# MySQL 数据源
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xhzb
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me

# JWT 令牌密钥（务必替换为足够长的随机字符串，jjwt 0.9.x 会按 Base64 解析该值）
TOKEN_SECRET=change-me-with-a-random-secret
# 令牌有效期（分钟）
TOKEN_EXPIRE_TIME=30

# Druid 监控台(/druid)管理账号，生产环境必须设置
DRUID_USERNAME=change-me
DRUID_PASSWORD=change-me

# 文件上传根目录（可选，默认 D:/ruoyi/uploadPath）
RUOYI_PROFILE=D:/ruoyi/uploadPath
