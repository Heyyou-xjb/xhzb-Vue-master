# 前端环境变量示例
# 使用方式：按需复制为 .env.local（已被 .gitignore 忽略）或配置到部署环境中。
# 说明：.env.development / .env.production / .env.staging 为不含敏感信息的构建模板。

# 页面标题
VITE_APP_TITLE=若依管理系统

# 运行环境标识
VITE_APP_ENV='development'

# 接口前缀（与 vite.config.js 中的代理配置配合使用）
VITE_APP_BASE_API='/dev-api'

# 「记住密码」功能的 RSA 密钥对（可选；留空则自动关闭该功能，不会明文存储密码）
# 密钥对生成：http://web.chacuo.net/netrsakeypair
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=
